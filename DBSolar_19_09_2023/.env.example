# Copy to .env for local docker-compose (do not commit .env)

DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated hosts (no spaces), e.g. v2.db-solar.co.in,localhost
ALLOWED_HOSTS=localhost,127.0.0.1,.easypanel.host
# VPS_PUBLIC_IP=72.60.98.248
# WEB_CONCURRENCY=1
# Do not set CSRF_TRUSTED_ORIGINS to bare hostnames — leave unset or use https://...

# PostgreSQL — used by entrypoint.sh and Django
DATABASE_URL=postgres://heramb:Heramb2023@db:5432/solar_db_v2

# Optional overrides when DATABASE_URL is not set
# DB_HOST=db
# DB_PORT=5432
# DB_NAME=solar_db_v2
# DB_USER=heramb
# DB_PASSWORD=Heramb2023

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
