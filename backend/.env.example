# Database Configuration
# To use another server with the same database name (db_solar), change host/port/user/password only:
#   postgresql://USERNAME:PASSWORD@HOST:PORT/db_solar
# Examples:
#   Same machine: postgresql://user:password@localhost:5432/db_solar
#   Other server: postgresql://myuser:mypass@192.168.1.50:5432/db_solar
#   Remote host:  postgresql://myuser:mypass@db.example.com:5432/db_solar
DATABASE_URL=postgresql://user:password@localhost:5432/db_solar

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=3000
NODE_ENV=development

# Email Configuration (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Firebase Admin SDK (for push notifications)
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

